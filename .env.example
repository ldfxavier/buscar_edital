# =======================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - PORTAL DE LICITAÇÕES
# Copie este arquivo para .env e preencha com seus dados.
# NUNCA comite o arquivo .env no repositório público!
# =======================================================

# Credenciais de Autenticação do Administrador
ADMIN_USER=admin
ADMIN_PASS=sua_senha_segura_aqui
SESSION_SECRET=seu_segredo_de_sessao_aleatorio_aqui

# Credenciais do Upstash Redis (Armazenamento em Nuvem)
UPSTASH_REDIS_REST_URL=https://sua-instancia-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu_token_rest_upstash_aqui

# Chaves de API de Inteligência Artificial (Gemini / IA)
GEMINI_API_KEY=sua_chave_gemini_api_aqui
